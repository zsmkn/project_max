# 複製本檔為 .env 並視需要覆寫（.env 已被 .gitignore 排除，請勿提交）
# 未設定時全部使用 src/config.ts 依組織代號推導的預設值（對應本機 network/ 的
# 五組織開發環境）。

# 每個組織（REG/OEM/SVC/INS/APP）各自的連線設定，依角色切換組織身分見
# src/fabricClient.ts 的 FabricConnectionPool；<ORG> 替換為大寫組織代號，
# 例如 FABRIC_SVC_PEER_ENDPOINT。
# FABRIC_<ORG>_MSP_ID=
# FABRIC_<ORG>_PEER_ENDPOINT=
# FABRIC_<ORG>_PEER_HOST_ALIAS=
# FABRIC_<ORG>_TLS_CERT_PATH=
# FABRIC_<ORG>_CERT_DIR=
# FABRIC_<ORG>_KEY_DIR=

# 查詢類交易（GetSummary／GetVehicleHistory）固定使用的組織身分。
# FABRIC_DEFAULT_QUERY_ORG=reg

# FABRIC_CHANNEL_NAME=vehiclechannel
# FABRIC_CHAINCODE_NAME=vehicle

# PQC_WALLET_DIR=

# GATEWAY_HTTPS_PORT=8443
# GATEWAY_TLS_CERT_PATH=
# GATEWAY_TLS_KEY_PATH=

# 階段 6：EIR1／EIR2 模擬服務（mocks/）呼叫用的內部服務埠（純 HTTP，僅限 loopback，
# 不套用 Kyber-only TLS 限制，見 src/server.ts 的說明）。
# GATEWAY_INTERNAL_HTTP_PORT=8080
