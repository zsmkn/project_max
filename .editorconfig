root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Windows PowerShell 5.1 會把無 BOM 的 UTF-8 當成系統 ANSI 碼頁讀取，中文註解會讓解析失敗。
[*.ps1]
charset = utf-8-bom
